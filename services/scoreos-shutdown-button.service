[Unit]
Description=SCOREOS Physical Safe Shutdown Button
After=scoreos-web.service
Wants=scoreos-web.service

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/venv/bin/python -u {{INSTALL_DIR}}/scripts/shutdown_button.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
