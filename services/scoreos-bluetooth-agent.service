[Unit]
Description=SCOREOS Bluetooth Pairing Agent
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
User=root
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/venv/bin/python -u {{INSTALL_DIR}}/scripts/scoreos-bluetooth-agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
