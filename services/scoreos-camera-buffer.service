[Unit]
Description=SCOREOS Camera Pre-Roll Buffer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
RuntimeDirectory=scoreos
RuntimeDirectoryMode=0755
WorkingDirectory={{INSTALL_DIR}}
ExecStartPre=/usr/bin/python3 -u {{INSTALL_DIR}}/scripts/wait_for_camera.py
ExecStart=/usr/bin/python3 -u {{INSTALL_DIR}}/scripts/camera_buffer.py
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
