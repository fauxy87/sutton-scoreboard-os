[Unit]
Description=SCOREOS Automatic Highlight Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart=/usr/bin/python3 -u {{INSTALL_DIR}}/scripts/highlight_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
