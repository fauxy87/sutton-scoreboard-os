[Unit]
Description=SCOREOS Web Interface
After=network.target sutton-scoreboard.service
Wants=sutton-scoreboard.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/sutton-scoreboard-os
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/pi/sutton-scoreboard-os/web/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
