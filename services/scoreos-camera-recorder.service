[Unit]
Description=SCOREOS Camera Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{INSTALL_DIR}}/venv/bin/python -u {{INSTALL_DIR}}/scripts/camera_recorder.py
Restart=no
RestartSec=5

[Install]
WantedBy=multi-user.target
