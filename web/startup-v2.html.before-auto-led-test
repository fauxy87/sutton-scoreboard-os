#<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title>SCOREOS Ground Control Startup</title>

    <style>
        :root {
            --green: #35d07f;
            --green-dark: #163d2b;
            --yellow: #f4c95d;
            --red: #ff6b6b;
            --white: #ffffff;
            --muted: #aebcb5;
            --panel: rgba(8, 20, 14, 0.88);
            --panel-soft: rgba(255, 255, 255, 0.04);
            --border: rgba(255, 255, 255, 0.12);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px;
            overflow-x: hidden;
            overflow-y: auto;
            background:
                radial-gradient(
                    circle at top,
                    #1b4933 0%,
                    #0b1c13 42%,
                    #030705 100%
                );
            color: var(--white);
            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }

        .shell {
            width: min(1180px, 100%);
            min-height: min(720px, calc(100vh - 44px));
            display: grid;
            grid-template-rows: auto auto 1fr auto;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 22px;
            background: var(--panel);
            box-shadow:
                0 28px 80px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
        }

        .header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 22px;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 18px;
            background:
                linear-gradient(
                    145deg,
                    rgba(53, 208, 127, 0.24),
                    rgba(53, 208, 127, 0.07)
                );
            font-size: 28px;
            box-shadow:
                inset 0 0 0 1px rgba(53, 208, 127, 0.24);
        }

        .brand h1 {
            margin: 0;
            font-size: clamp(24px, 4vw, 40px);
            letter-spacing: 0.04em;
            line-height: 1;
        }

        .brand p {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .header-badge {
            margin-left: auto;
            padding: 9px 13px;
            border: 1px solid rgba(53, 208, 127, 0.3);
            border-radius: 999px;
            background: rgba(53, 208, 127, 0.08);
            color: #9af0bd;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .progress-section {
            padding: 20px 28px 22px;
            border-bottom: 1px solid var(--border);
        }

        .progress-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 13px;
        }

        .stage-title {
            font-size: clamp(22px, 3vw, 34px);
            font-weight: 750;
        }

        .progress-value {
            color: var(--green);
            font-size: clamp(28px, 4vw, 44px);
            font-weight: 800;
            font-variant-numeric: tabular-nums;
        }

        .progress-track {
            height: 15px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.09);
            box-shadow:
                inset 0 2px 4px rgba(0, 0, 0, 0.4);
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            border-radius: inherit;
            background:
                linear-gradient(
                    90deg,
                    #1cad64,
                    #42e38c
                );
            box-shadow:
                0 0 20px rgba(53, 208, 127, 0.42);
            transition: width 0.5s ease;
        }

        .main-grid {
            min-height: 0;
            display: grid;
            grid-template-columns: minmax(280px, 0.85fr) minmax(380px, 1.35fr);
        }

        .panel {
            min-width: 0;
            padding: 22px 26px;
        }

        .panel + .panel {
            border-left: 1px solid var(--border);
        }

        .panel-title {
            margin: 0 0 17px;
            color: #dce7e1;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        .status-list {
            display: grid;
            gap: 9px;
        }

        .status-item {
            display: grid;
            grid-template-columns: 13px 1fr auto;
            align-items: center;
            gap: 11px;
            min-height: 43px;
            padding: 9px 12px;
            border: 1px solid transparent;
            border-radius: 11px;
            background: var(--panel-soft);
        }

        .status-dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #647069;
            box-shadow: 0 0 0 4px rgba(100, 112, 105, 0.1);
        }

        .status-item.complete .status-dot {
            background: var(--green);
            box-shadow: 0 0 0 4px rgba(53, 208, 127, 0.12);
        }

        .status-item.active {
            border-color: rgba(244, 201, 93, 0.2);
            background: rgba(244, 201, 93, 0.07);
        }

        .status-item.active .status-dot {
            background: var(--yellow);
            box-shadow: 0 0 0 4px rgba(244, 201, 93, 0.12);
            animation: pulse 1.25s infinite;
        }

        .status-name {
            font-size: 15px;
            font-weight: 700;
        }

        .status-state {
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
        }

        .console {
            height: 100%;
            min-height: 290px;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: rgba(0, 0, 0, 0.26);
        }

        .console-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--muted);
            font-size: 12px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .console-light {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 10px rgba(53, 208, 127, 0.7);
        }

        .console-body {
            height: calc(100% - 39px);
            max-height: 330px;
            overflow-y: auto;
            padding: 13px 15px 18px;
            font-family:
                "Courier New",
                Courier,
                monospace;
            font-size: 13px;
            line-height: 1.7;
            scrollbar-width: thin;
        }

        .console-line {
            display: grid;
            grid-template-columns: 72px 22px 1fr;
            gap: 5px;
            color: #9eaaa4;
        }

        .console-time {
            color: #6f7c75;
        }

        .console-line.complete {
            color: #b9e9cc;
        }

        .console-line.complete .console-symbol {
            color: var(--green);
        }

        .console-line.active {
            color: #fff0bc;
            font-weight: 700;
        }

        .console-line.active .console-symbol {
            color: var(--yellow);
            animation: blink 1s infinite;
        }

        .footer {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            padding: 14px 26px;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 12px;
        }

        .footer span:nth-child(2) {
            text-align: center;
        }

        .footer span:last-child {
            text-align: right;
        }

        .connection-error {
            color: var(--red) !important;
        }


        .ready-section {
            padding: 18px 26px;
            border-top: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.025);
        }

        .ready-card {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 20px;
            padding: 18px 20px;
            border: 1px solid rgba(244, 201, 93, 0.22);
            border-radius: 16px;
            background: rgba(244, 201, 93, 0.055);
            transition:
                border-color 0.35s ease,
                background 0.35s ease,
                box-shadow 0.35s ease;
        }

        .ready-card.ready {
            border-color: rgba(53, 208, 127, 0.35);
            background: rgba(53, 208, 127, 0.075);
            box-shadow:
                0 0 26px rgba(53, 208, 127, 0.08);
        }

        .ready-copy {
            min-width: 0;
        }

        .ready-label {
            margin-bottom: 6px;
            color: var(--yellow);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        .ready-card.ready .ready-label {
            color: var(--green);
        }

        .ready-title {
            margin: 0;
            font-size: clamp(21px, 3vw, 30px);
            line-height: 1.15;
        }

        .ready-message {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .ready-icon {
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(244, 201, 93, 0.12);
            color: var(--yellow);
            font-size: 27px;
            font-weight: 800;
        }

        .ready-card.ready .ready-icon {
            background: rgba(53, 208, 127, 0.14);
            color: var(--green);
        }

        .startup-actions {
            display: none;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-top: 14px;
        }

        .startup-actions.visible {
            display: grid;
        }

        .startup-action {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 50px;
            padding: 12px 16px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.055);
            color: var(--white);
            font-size: 14px;
            font-weight: 800;
            text-align: center;
            text-decoration: none;
            transition:
                transform 0.15s ease,
                border-color 0.15s ease,
                background 0.15s ease;
        }

        .startup-action:hover,
        .startup-action:focus-visible {
            transform: translateY(-1px);
            border-color: rgba(53, 208, 127, 0.45);
            background: rgba(53, 208, 127, 0.1);
            outline: none;
        }

        .startup-action.primary {
            border-color: rgba(53, 208, 127, 0.38);
            background: rgba(53, 208, 127, 0.13);
            color: #baf4d0;
        }

        @keyframes pulse {
            50% {
                transform: scale(1.15);
                opacity: 0.72;
            }
        }

        @keyframes blink {
            50% {
                opacity: 0.35;
            }
        }

        @media (max-width: 760px) {
            body {
                align-items: flex-start;
                padding: 12px;
            }

            .shell {
                min-height: calc(100vh - 24px);
                border-radius: 16px;
            }

            .header {
                padding: 18px;
            }

            .logo {
                width: 54px;
                height: 54px;
                font-size: 31px;
            }

            .header-badge {
                display: none;
            }

            .progress-section {
                padding: 18px;
            }

            .main-grid {
                grid-template-columns: 1fr;
            }

            .panel {
                padding: 18px;
            }

            .panel + .panel {
                border-top: 1px solid var(--border);
                border-left: 0;
            }

            .ready-card {
                grid-template-columns: 1fr auto;
                padding: 16px;
            }

            .startup-actions {
                grid-template-columns: 1fr;
            }

            .startup-action {
                min-height: 52px;
            }

            .footer {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .footer span:nth-child(2),
            .footer span:last-child {
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <main class="shell">
        <header class="header">
            <div class="logo">🏏</div>

            <div class="brand">
                <h1>SCOREOS</h1>
                <p>Ground Control Startup</p>
            </div>

            <div
                id="api-badge"
                class="header-badge"
            >
                Status API online
            </div>
        </header>

        <section class="progress-section">
            <div class="progress-heading">
                <div
                    id="stage-title"
                    class="stage-title"
                >
                    Initialising SCOREOS
                </div>

                <div
                    id="progress-value"
                    class="progress-value"
                >
                    0%
                </div>
            </div>

            <div
                class="progress-track"
                role="progressbar"
                aria-label="Startup progress"
                aria-valuemin="0"
                aria-valuemax="100"
            >
                <div
                    id="progress-fill"
                    class="progress-fill"
                ></div>
            </div>
        </section>

        <section class="main-grid">
            <div class="panel">
                <h2 class="panel-title">
                    System Status
                </h2>

                <div
                    id="status-list"
                    class="status-list"
                ></div>
            </div>

            <div class="panel">
                <h2 class="panel-title">
                    Startup Console
                </h2>

                <div class="console">
                    <div class="console-header">
                        <span class="console-light"></span>
                        SCOREOS boot log
                    </div>

                    <div
                        id="console-body"
                        class="console-body"
                    ></div>
                </div>
            </div>
        </section>


        <section class="ready-section">
            <div id="ready-card" class="ready-card">
                <div class="ready-copy">
                    <div id="ready-label" class="ready-label">
                        Match Day Check
                    </div>

                    <h2 id="ready-title" class="ready-title">
                        Initialising match systems
                    </h2>

                    <p id="ready-message" class="ready-message">
                        SCOREOS is checking the scoreboard,
                        Bluetooth and scoring services.
                    </p>
                </div>

                <div id="ready-icon" class="ready-icon">
                    …
                </div>
            </div>

            <nav
                id="startup-actions"
                class="startup-actions"
                aria-label="SCOREOS navigation"
            >
                <a
                    class="startup-action primary"
                    href="/control"
                >
                    🏏 Start Scoring
                </a>

                <a
                    class="startup-action"
                    href="/tv"
                    target="_blank"
                    rel="noopener"
                >
                    📺 TV Display
                </a>

                <a
                    class="startup-action"
                    href="/groundcontrol"
                >
                    🛠 Ground Control
                </a>
            </nav>
        </section>

        <footer class="footer">
            <span>Sutton Cricket Club</span>
            <span id="footer-status">Initialising match systems</span>
            <span>SCOREOS Ground Control</span>
        </footer>
    </main>

    <script>
        const stages = [
            {
                id: "boot",
                title: "Starting SCOREOS",
                system: "SCOREOS Core",
                progress: 10
            },
            {
                id: "services",
                title: "Loading services",
                system: "Ground Control",
                progress: 25
            },
            {
                id: "arduino",
                title: "Checking Arduino",
                system: "Arduino",
                progress: 40
            },
            {
                id: "display",
                title: "Testing scoreboard",
                system: "LED Display",
                progress: 60
            },
            {
                id: "bluetooth",
                title: "Starting Bluetooth",
                system: "Bluetooth",
                progress: 80
            },
            {
                id: "ready",
                title: "Match Ready",
                system: "Match Engine",
                progress: 100
            }
        ];

        const stageTitle =
            document.getElementById("stage-title");
        const progressFill =
            document.getElementById("progress-fill");
        const progressValue =
            document.getElementById("progress-value");
        const statusList =
            document.getElementById("status-list");
        const consoleBody =
            document.getElementById("console-body");
        const apiBadge =
            document.getElementById("api-badge");
        const footerStatus =
            document.getElementById("footer-status");

        function getStageIndex(stageId) {
            return stages.findIndex(
                (stage) => stage.id === stageId
            );
        }

        function renderStatus(currentStage) {
            const currentIndex =
                getStageIndex(currentStage.id);

            statusList.innerHTML = stages.map(
                (stage, index) => {
                    let className = "";
                    let state = "Waiting";

                    if (index < currentIndex) {
                        className = "complete";
                        state = "Online";
                    } else if (index === currentIndex) {
                        className = "active";
                        state = "Starting";
                    }

                    if (
                        currentStage.progress >= 100 &&
                        index <= currentIndex
                    ) {
                        className = "complete";
                        state = "Online";
                    }

                    return `
                        <div class="status-item ${className}">
                            <span class="status-dot"></span>
                            <span class="status-name">
                                ${stage.system}
                            </span>
                            <span class="status-state">
                                ${state}
                            </span>
                        </div>
                    `;
                }
            ).join("");
        }

        function renderConsole(startup) {
            const currentIndex =
                getStageIndex(startup.stage.id);

            const now = new Date();

                   const visibleStages = stages.filter(
    (stage, index) => index <= currentIndex
);

const lines = visibleStages.map(
    (stage, index) => {
        const time = new Date(
            now.getTime() -
            Math.max(
                0,
                currentIndex - index
            ) * 1000
        ).toLocaleTimeString(
            "en-GB",
            {
                hour12: false
            }
        );

        let className = "";
        let symbol = "•";

        if (index < currentIndex) {
            className = "complete";
            symbol = "✓";
        } else if (index === currentIndex) {
            className = "active";
            symbol = "›";
        }

        if (
            startup.stage.progress >= 100 &&
            index <= currentIndex
        ) {
            className = "complete";
            symbol = "✓";
        }

        return `
            <div class="console-line ${className}">
                <span class="console-time">
                    ${time}
                </span>
                <span class="console-symbol">
                    ${symbol}
                </span>
                <span>${stage.title}</span>
            </div>
        `;
    }
);

            if (
                Array.isArray(startup.log) &&
                startup.log.length
            ) {
                startup.log.forEach((message) => {
                    const time =
                        new Date().toLocaleTimeString(
                            "en-GB",
                            {
                                hour12: false
                            }
                        );

                    lines.push(`
                        <div class="console-line complete">
                            <span class="console-time">
                                ${time}
                            </span>
                            <span class="console-symbol">
                                ✓
                            </span>
                            <span>${message}</span>
                        </div>
                    `);
                });
            }

            consoleBody.innerHTML = lines.join("");
            consoleBody.scrollTop =
                consoleBody.scrollHeight;
        }
        let redirectStarted = false;

        async function updateStartupStatus() {
            try {
                const response = await fetch(
                    "/api/startup",
                    {
                        cache: "no-store"
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        `HTTP ${response.status}`
                    );
                }

                const startup =
                    await response.json();

                const progress = Math.max(
                    0,
                    Math.min(
                        100,
                        Number(
                            startup.stage?.progress
                        ) || 0
                    )
                );

                const currentStage =
                    startup.stage || stages[0];

                stageTitle.textContent =
                    currentStage.title ||
                    "Starting SCOREOS";

                progressFill.style.width =
                    `${progress}%`;

                progressValue.textContent =
                    `${progress}%`;

                progressFill.parentElement.setAttribute(
                    "aria-valuenow",
                    String(progress)
                );

                apiBadge.textContent =
                    "Status API online";
                apiBadge.classList.remove(
                    "connection-error"
                );

                footerStatus.textContent =
                    progress >= 100
                        ? "Ground Control ready"
                        : "Initialising match systems";

                const readyCard =
                    document.getElementById("ready-card");
                const readyLabel =
                    document.getElementById("ready-label");
                const readyTitle =
                    document.getElementById("ready-title");
                const readyMessage =
                    document.getElementById("ready-message");
                const readyIcon =
                    document.getElementById("ready-icon");
                const startupActions =
                    document.getElementById("startup-actions");

                if (progress >= 100) {
                    readyCard.classList.add("ready");
                    startupActions.classList.add("visible");

                    readyLabel.textContent =
                        "Match Day Ready";
                    readyTitle.textContent =
                        "Ready for first ball";
                    readyMessage.textContent =
                        "All SCOREOS startup checks have completed.";
                    readyIcon.textContent = "✓";
                } else {
                    readyCard.classList.remove("ready");
                    startupActions.classList.remove("visible");

                    readyLabel.textContent =
                        "Match Day Check";
                    readyTitle.textContent =
                        currentStage.title ||
                        "Initialising match systems";
                    readyMessage.textContent =
                        `SCOREOS startup is ${progress}% complete.`;
                    readyIcon.textContent = "…";
                }

                renderStatus(currentStage);
                renderConsole(startup);
                if (
                 !redirectStarted &&
                startup.bluetooth?.waiting_for_first_packet === false &&
                startup.bluetooth?.connected === true &&
                String(startup.match?.mode || "").toLowerCase() === "playcricket"
             ) {
                redirectStarted = true;


                setTimeout(() => {
                   window.location.replace("/tv");
                 }, 3000);

                   return;
                }
            } catch (error) {
                apiBadge.textContent =
                    "Status API offline";
                apiBadge.classList.add(
                    "connection-error"
                );

                footerStatus.textContent =
                    "Waiting for Ground Control";
                footerStatus.classList.add(
                    "connection-error"
                );
            }
        }

        updateStartupStatus();

        setInterval(
            updateStartupStatus,
            1000
        );
    </script>
</body>
</html>
