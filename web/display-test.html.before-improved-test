<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SCOREOS Display Test</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f2f4f3;
    color: #1c2b23;
}

header {
    background: #174f32;
    color: white;
    padding: 20px;
    text-align: center;
}

main {
    max-width: 700px;
    margin: 20px auto;
    padding: 0 14px;
}

.card {
    background: white;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 16px;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
}

#patternName {
    font-size: 28px;
    font-weight: bold;
    text-align: center;
    color: #174f32;
}

#patternPosition,
#status {
    margin-top: 8px;
    text-align: center;
}

.score {
    margin-top: 18px;
    padding: 24px;
    border-radius: 12px;
    background: #101612;
    color: #f2c94c;
    text-align: center;
    font-family: monospace;
    font-size: 50px;
    font-weight: bold;
}

.controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

button,
a {
    min-height: 54px;
    border: 0;
    border-radius: 10px;
    padding: 12px;
    font-size: 17px;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
}

.primary {
    background: #174f32;
    color: white;
}

.secondary {
    background: #e5ebe7;
    color: #174f32;
}

.warning {
    background: #f2c94c;
    color: #28230c;
}

.restore {
    grid-column: 1 / -1;
    background: #b3261e;
    color: white;
}

button:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.navigation a {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e5ebe7;
    color: #174f32;
}

#error {
    margin-top: 14px;
    text-align: center;
    color: #b3261e;
    font-weight: bold;
}

@media (max-width: 500px) {
    .controls,
    .navigation {
        grid-template-columns: 1fr;
    }

    .restore {
        grid-column: auto;
    }
}
</style>
</head>

<body>
<header>
    <h1>SCOREOS Display Test</h1>
    <div>Physical scoreboard test controls</div>
</header>

<main>
    <section class="card">
        <div id="patternName">Ready</div>
        <div id="patternPosition">Press Start Test</div>
        <div class="score" id="scorePreview">---</div>
        <div id="status">Live match remains protected</div>
        <div id="error"></div>
    </section>

    <section class="card controls">
        <button class="primary" id="start">▶ Start Test</button>
        <button class="warning" id="pause" disabled>⏸ Pause</button>
        <button class="secondary" id="previous">◀ Previous</button>
        <button class="secondary" id="next">Next ▶</button>
        <button class="restore" id="restore">
            Restore Live Match
        </button>
    </section>

    <section class="card navigation">
        <a href="/dashboard">Dashboard</a>
        <a href="/diagnostics">Diagnostics</a>
    </section>
</main>

<script>
let currentIndex = 0;
let patternCount = 1;
let timer = null;
let testStarted = false;

const nameBox = document.getElementById("patternName");
const positionBox = document.getElementById("patternPosition");
const scoreBox = document.getElementById("scorePreview");
const statusBox = document.getElementById("status");
const errorBox = document.getElementById("error");
const startButton = document.getElementById("start");
const pauseButton = document.getElementById("pause");

async function control(action, index) {
    errorBox.textContent = "";

    const payload = {action};

    if (index !== undefined) {
        payload.index = index;
    }

    const response = await fetch("/api/control", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify(payload)
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
        throw new Error(result.error || "Command failed");
    }

    return result;
}

function showPattern(result) {
    const test = result.test;
    const pattern = test.pattern;

    currentIndex = test.index;
    patternCount = test.count;

    nameBox.textContent = test.name;
    positionBox.textContent =
        `Pattern ${test.index + 1} of ${test.count}`;

    scoreBox.textContent =
        `${pattern.total}/${pattern.wickets}`;

    statusBox.textContent =
        "Display Test active — live match saved";
}

async function startTest() {
    try {
        const result = await control(
            "display_test_start",
            currentIndex
        );

        testStarted = true;
        showPattern(result);
        startAutomatic();
    } catch (error) {
        errorBox.textContent = error.message;
    }
}

async function sendPattern(index) {
    try {
        if (!testStarted) {
            const result = await control(
                "display_test_start",
                index
            );

            testStarted = true;
            showPattern(result);
            return;
        }

        const result = await control(
            "display_test_pattern",
            index
        );

        showPattern(result);
    } catch (error) {
        errorBox.textContent = error.message;
        pauseTest();
    }
}

function startAutomatic() {
    pauseTest();

    startButton.disabled = true;
    pauseButton.disabled = false;

    timer = setInterval(() => {
        const nextIndex =
            (currentIndex + 1) % patternCount;

        sendPattern(nextIndex);
    }, 3000);
}

function pauseTest() {
    if (timer !== null) {
        clearInterval(timer);
        timer = null;
    }

    startButton.disabled = false;
    pauseButton.disabled = true;

    if (testStarted) {
        statusBox.textContent =
            "Display Test paused — pattern remains displayed";
    }
}

async function restoreMatch() {
    pauseTest();

    try {
        const result = await control(
            "display_test_restore"
        );

        testStarted = false;
        currentIndex = 0;
        patternCount = 1;

        nameBox.textContent = "Live Match Restored";
        positionBox.textContent =
            `Mode: ${result.mode}`;
        scoreBox.textContent = "LIVE";
        statusBox.textContent =
            "The saved match has been returned to the scoreboard";
    } catch (error) {
        errorBox.textContent = error.message;
    }
}

document.getElementById("start")
    .addEventListener("click", startTest);

document.getElementById("pause")
    .addEventListener("click", pauseTest);

document.getElementById("next")
    .addEventListener("click", () => {
        pauseTest();
        sendPattern((currentIndex + 1) % patternCount);
    });

document.getElementById("previous")
    .addEventListener("click", () => {
        pauseTest();

        const previous =
            (currentIndex - 1 + patternCount) %
            patternCount;

        sendPattern(previous);
    });

document.getElementById("restore")
    .addEventListener("click", restoreMatch);
</script>
</body>
</html>
