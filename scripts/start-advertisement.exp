#!/usr/bin/expect -f

set timeout 15
set uuid "5a0d6a15-b664-4304-8530-3a0ec53e5bc1"

set adapter [lindex $argv 0]

if {$adapter eq ""} {
    puts "No Bluetooth adapter was supplied"
    exit 1
}

puts "Using Bluetooth adapter: $adapter"
spawn /usr/bin/btmgmt -i $adapter

expect -re {\[[^]]+\]>}

send "power on\r"
expect -re {\[[^]]+\]>}

send "le on\r"
expect -re {\[[^]]+\]>}

send "name SCOREOS\r"
expect -re {\[[^]]+\]>}

send "connectable on\r"
expect -re {\[[^]]+\]>}

send "advertising off\r"
expect -re {\[[^]]+\]>}

send "clr-adv\r"
expect -re {\[[^]]+\]>}

send "add-adv -c -g -n -u $uuid 1\r"

expect {
    -re {Instance added: 1} {}
    timeout {
        puts "Failed to add SCOREOS advertisement"
        exit 1
    }
}

expect -re {\[[^]]+\]>}

send "advertising on\r"
expect -re {\[[^]]+\]>}

send "advinfo\r"

expect {
    -re {Instances list with 1 item} {}
    timeout {
        puts "Advertisement was not verified"
        exit 1
    }
}

expect -re {\[[^]]+\]>}

send "quit\r"
expect eof

puts "SCOREOS Bluetooth advertisement started."
exit 0
